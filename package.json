  "type": "module",
  "bugs": {
    "url": "https://github.com/Suja16/laxmi-cheat-fund/issues"
  },
  "homepage": "https://github.com/Suja16/laxmi-cheat-fund#readme",
  "dependencies": {
    "@1inch/limit-order-sdk": "^5.2.0",
    "axios": "^1.12.2",
    "body-parser": "^2.2.0",
    "dotenv": "^17.2.2",
    "ethers": "^6.15.0",
    "express": "^5.1.0",
    "readline": "^1.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/readline-sync": "^1.4.8"
  }
